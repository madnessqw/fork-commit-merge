import json
from datetime import datetime, timezone

path = '/home/gokhan/UniverseCreator/STATE.json'
with open(path) as f:
    s = json.load(f)

live_list = s['products']['live']
active = s['products']['active']

# 1. Remove duplicate terraink (index 157 has no 'slug' key, only 's')
original_len = len(live_list)
live_list = [p for p in live_list if not (p.get('s') == 'terraink' and 'slug' not in p)]
removed = original_len - len(live_list)
print(f"Removed {removed} duplicate terraink entries")

# 2. Add missing active products to live
live_slugs = {p.get('slug') or p.get('s') for p in live_list}
added = 0
for p in active:
    slug = p.get('slug')
    if slug and slug not in live_slugs and p.get('status') == 'live':
        live_list.append(p)
        added += 1
        live_slugs.add(slug)

print(f"Added {added} missing products to live list")
print(f"New live count: {len(live_list)}")

# 3. Update top-level counts
s['products']['live'] = live_list
s['live_count'] = len(live_list)
s['last_updated'] = datetime.now(timezone.utc).isoformat()
s['message'] = f"Cycle {s.get('cycle', '?')}. Kimi cycle 1177: fixed {added} missing live products + {removed} duplicate removed."

with open(path, 'w') as f:
    json.dump(s, f, indent=2, ensure_ascii=False)

print("STATE.json updated successfully")
