import json
with open('STATE.json') as f:
    state = json.load(f)
products = state.get('products', {})

drift = []
fallback = []
for slug, entries in products.items():
    if not isinstance(entries, list):
        entries = [entries]
    p = entries[-1]  # son entry
    canonical = p.get('canonical_health_status', '')
    health = p.get('health_status', '')
    ideal = p.get('ideal_vercel_url', '')
    actual = p.get('vercel_url', '')
    name = p.get('name', p.get('n', slug))
    
    if canonical and canonical != 'healthy' and canonical != 'pending':
        drift.append({
            'slug': slug,
            'name': name,
            'canonical_status': canonical,
            'canonical_url': p.get('canonical_health_url', ''),
            'vercel_url': actual,
            'ideal': ideal,
            'note': p.get('note', '')
        })
    elif health == 'alternate_healthy':
        fallback.append({
            'slug': slug,
            'name': name,
            'health_status': health,
            'canonical_status': canonical,
            'vercel_url': actual,
            'ideal': ideal,
            'note': p.get('note', '')
        })

print(f"=== CANONICAL DRIFT ({len(drift)}) ===")
for d in drift:
    print(f"  {d['slug']}: {d['name']} | canonical={d['canonical_status']} | canonical_url={d['canonical_url']} | vercel={d['vercel_url']} | ideal={d['ideal']} | note={d['note']}")

print(f"\n=== FALLBACK HEALTHY ({len(fallback)}) ===")
for f in fallback:
    print(f"  {f['slug']}: {f['name']} | health={f['health_status']} | canonical={f['canonical_status']} | vercel={f['vercel_url']} | ideal={f['ideal']} | note={f['note']}")
