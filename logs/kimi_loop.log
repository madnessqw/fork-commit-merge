import json, datetime

# Read current STATE
try:
    with open('STATE.json') as f:
        state = json.load(f)
except Exception as e:
    state = {}

live = len(state.get('products', {}).get('live', []))
active = len(state.get('products', {}).get('active', []))

# Count healthy
healthy = 0
unhealthy = 0
for p in state.get('products', {}).get('active', []):
    if p.get('health_status') == 'healthy':
        healthy += 1
    elif p.get('health_status') in ('unhealthy', 'error'):
        unhealthy += 1

health_pct = round(healthy / live * 100, 1) if live else 0

# Count canonical drift
drift = 0
for p in state.get('products', {}).get('active', []):
    if p.get('canonical_health_status') not in ('healthy', None):
        drift += 1
    elif p.get('canonical_health_status') is None and p.get('status') == 'live':
        # pending means not checked or not healthy
        if p.get('canonical_probe_url') != p.get('effective_health_url'):
            drift += 1

# Simpler: use state's explicit drift count if available
drift = state.get('canonical_url_drift', drift)

cycle = state.get('cycle', 1158) + 1

entry = {
    'ts': datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
    'cycle': cycle,
    'live': live,
    'healthy': healthy,
    'health_pct': health_pct,
    'grade': 'A' if health_pct >= 90 else 'B',
    'unhealthy': unhealthy,
    'checkout_gap': state.get('missing_checkout', 0),
    'deploy_gap': state.get('deploy_missing_or_bad_url', 0),
    'canonical_drift': drift,
    'fallback_healthy': len([p for p in state.get('products', {}).get('active', []) if p.get('health_status') == 'alternate_healthy']),
}

with open('logs/health_trend.jsonl', 'a') as f:
    f.write(json.dumps(entry) + '\n')

print(f'Added cycle {cycle}: live={live}, healthy={healthy}, pct={health_pct}%, drift={drift}')
"
