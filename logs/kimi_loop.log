import json
from pathlib import Path

products_dir = Path("/home/gokhan/UniverseCreator/products")

fixes = {
    "croncraft": "https://quickcron.vercel.app",
    "html-entity-encoder": "https://html-entity-encoder-1p2e2xs77-madnessqws-projects.vercel.app",
    "chmod-calculator": "https://chmod-calculator-5atogp6t7-madnessqws-projects.vercel.app",
    "terminal-os": "https://terminal-os-green.vercel.app",
    "terraink": "https://terraink-flax.vercel.app",
    "nginx-config": "https://nginx-config-egj3ho5tp-madnessqws-projects.vercel.app",
}

changed = []
for slug, fallback_url in fixes.items():
    path = products_dir / slug / "product.json"
    if not path.exists():
        print(f"MISSING: {path}")
        continue
    data = json.loads(path.read_text(encoding="utf-8"))
    old_canonical = data.get("canonical_url")
    old_override = data.get("canonical_url_override")
    data["canonical_url"] = fallback_url
    data["canonical_url_override"] = fallback_url
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    changed.append(slug)
    print(f"FIXED {slug}: canonical_url {old_canonical} -> {fallback_url}, override {old_override} -> {fallback_url}")

print(f"\nTotal fixed: {len(changed)}")
EOF
