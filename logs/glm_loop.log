# STATE_SUMMARY'den deploy_missing ve spec_ready oku
python3 -c "
import json, time, os

try:
    summary = json.load(open('/home/gokhan/UniverseCreator/STATE_SUMMARY.json'))
except:
    summary = {}

deploy_gap = summary.get('deploy_missing', 0) or summary.get('no_url_count', 0)
