             return account
-        try:
-            until = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
-            if until <= now:
-                return account
-        except (ValueError, TypeError):
+        until = _parse_aware_datetime(raw)
+        if until is None or until <= now:
             return account
     return None
 
 

