import os, json
products_dir = '/home/gokhan/UniverseCreator/products'
required_fields = ['name','slug','tagline','description','price','features','tech_stack','status','vercel_url','checkout_url']
field_coverage = {}
for slug in sorted(os.listdir(products_dir)):
    pkg = os.path.join(products_dir, slug, 'product.json')
    if os.path.isfile(pkg):
        try:
            p = json.load(open(pkg))
            for f in required_fields:
                if f not in p or not p[f]:
                    field_coverage.setdefault(f, []).append(slug)
        except: pass

print('Eksik alanlar (product.json):')
for f in sorted(field_coverage.keys(), key=lambda x: len(field_coverage[x])):
    print(f'  {f}: {len(field_coverage[f])} üründe eksik')
    if len(field_coverage[f]) <= 3:
        for s in field_coverage[f]:
            print(f'    - {s}')
