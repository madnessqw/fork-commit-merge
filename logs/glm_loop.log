prods = state['products']['active']
# find products sharing same checkout URL (duplicate checkout)
from collections import Counter
checkout_urls = [p.get('checkout_url','') for p in prods if p.get('checkout_url','')]
dupes = {k:v for k,v in Counter(checkout_urls).items() if v > 1}
print(f'Products: {len(prods)}')
print(f'Unique checkout URLs: {len(set(checkout_urls))}')
print(f'Duplicate checkout URLs: {len(dupes)}')
for url, count in sorted(dupes.items(), key=lambda x: -x[1])[:10]:
    names = [p['name'] for p in prods if p.get('checkout_url','') == url]
    print(f'  {count}x: {names}')
