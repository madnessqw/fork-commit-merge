[0m$ [0mcat /home/gokhan/UniverseCreator/products/jwt-generator/api/process.js
const crypto = require('crypto');

// Vercel timeout koruması - 8 saniyede kes
const TIMEOUT_MS = 8000;

module.exports = async function handler(req, res) {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type, X-License-Key');
  if (req.method === 'OPTIONS') return res.status(200).end();

  if (req.method === 'GET') {
    return res.status(200).json({
      status: 'ok', service: 'JWT Generator API', version: '1.0.1',
      endpoints: { POST: '/api/process - Generate or verify JWT', GET: '/api/health - Health check' },
      features: ['Generate JWT with HS256', 'Verify JWT signature', 'Decode JWT payload']
    });
  }

  if (req.method !== 'POST') return res.status(405).json({ error: 'Method not allowed' });

  // Timeout timer
  const timeout = setTimeout(() => {
    return res.status(504).json({ error: 'Request timeout', message: 'Operation took too long' });
  }, TIMEOUT_MS);

  try {
    const { action, payload, token, secret } = req.body;

    // Payload boyut limiti
    const bodySize = JSON.stringify(req.body).length;
    if (bodySize > 100000) {
      clearTimeout(timeout);
      return res.status(413).json({ error: 'Payload too large', maxSize: '100KB' });
    }

    if (action === 'generate') {
      if (!payload || !secret) {
        clearTimeout(timeout);
        return res.status(400).json({ error: 'Payload and secret required' });
      }
      // Secret boyut limiti
      if (secret.length > 1000) {
        clearTimeout(timeout);
        return res.status(400).json({ error: 'Secret too long', maxLength: 1000 });
      }
      const header = { alg: 'HS256', typ: 'JWT' };
      const encodedHeader = Buffer.from(JSON.stringify(header)).toString('base64url');
      const encodedPayload = Buffer.from(JSON.stringify(payload)).toString('base64url');
      const signature = crypto.createHmac('sha256', secret).update(`${encodedHeader}.${encodedPayload}`).digest('base64url');
      clearTimeout(timeout);
      return res.json({ success: true, token: `${encodedHeader}.${encodedPayload}.${signature}` });
    }

    if (action === 'verify') {
      if (!token || !secret) {
        clearTimeout(timeout);
        return res.status(400).json({ error: 'Token and secret required' });
      }
      const [h, p, s] = token.split('.');
      if (!h || !p || !s) {
        clearTimeout(timeout);
        return res.status(400).json({ error: 'Invalid token format' });
      }
      const expectedSig = crypto.createHmac('sha256', secret).update(`${h}.${p}`).digest('base64url');
      const valid = s === expectedSig;
      clearTimeout(timeout);
      return res.json({ success: true, valid, payload: valid ? JSON.parse(Buffer.from(p, 'base64url').toString()) : null });
    }

    if (action === 'decode') {
      if (!token) {
        clearTimeout(timeout);
        return res.status(400).json({ error: 'Token required' });
      }
      const [h, p] = token.split('.');
      if (!h || !p) {
        clearTimeout(timeout);
        return res.status(400).json({ error: 'Invalid token format' });
      }
      clearTimeout(timeout);
      return res.json({ success: true, header: JSON.parse(Buffer.from(h, 'base64url').toString()), payload: JSON.parse(Buffer.from(p, 'base64url').toString()) });
    }

    clearTimeout(timeout);
    return res.status(400).json({ error: 'Invalid action. Use: generate, verify, decode' });
  } catch (err) {
    clearTimeout(timeout);
    return res.status(500).json({ error: 'Internal error', message: err.message });
  }
};
