import ast, os, sys

scripts_dir = 'scripts'
py_files = [f for f in os.listdir(scripts_dir) if f.endswith('.py')]

for fname in sorted(py_files):
    fpath = os.path.join(scripts_dir, fname)
    try:
        with open(fpath) as f:
            tree = ast.parse(f.read())
        has_docstring = ast.get_docstring(tree) is not None
        funcs = [n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)]
        funcs_no_doc = [n.name for n in funcs if not ast.get_docstring(n)]
        if not has_docstring or funcs_no_doc:
            print(f'{fname}: module_doc={has_docstring}, funcs_no_doc={len(funcs_no_doc)}')
    except:
        pass
