+            {"slug": "b", "price": "$19"},
+        ]
+        state_file = tmp_path / "STATE.json"
+        state_file.write_text(json.dumps(self._make_state(products)))
+        result = fix_product_prices(state_path=state_file, dry_run=True)
+        assert result["fixed_count"] == 1
