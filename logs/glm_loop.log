import os, json
products_dir = '/home/gokhan/UniverseCreator/products'
count = 0
has_pkg = 0
deps = {}
for slug in sorted(os.listdir(products_dir)):
    pkg_path = os.path.join(products_dir, slug, 'package.json')
    if os.path.isfile(pkg_path):
        has_pkg += 1
        try:
            pkg = json.load(open(pkg_path))
            for dep_type in ['dependencies', 'devDependencies']:
                for name, ver in pkg.get(dep_type, {}).items():
                    if name not in deps:
                        deps[name] = []
                    deps[name].append((slug, ver, dep_type))
        except: pass
    count += 1
print(f'Toplam ürün: {count}, package.json olan: {has_pkg}')
print(f'Benzersiz bağımlılık: {len(deps)}')
multi = {k:v for k,v in deps.items() if len(v) > 1}
print(f'Çoklu kullanım (>1 ürün): {len(multi)}')
for name in sorted(multi.keys())[:10]:
    print(f'  {name}: {len(multi[name])} ürün')
