        LAST_RUN_ERROR="$(echo "$output" | tail -3 | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g')"
        LAST_RUN_KIND="auth_switch"
        return 1
    fi
    if (( exit_code != 0 )); then
        LAST_RUN_ERROR="exit_code=$exit_code"

