for slug in drift_slugs:
    pj_path = f'/home/gokhan/UniverseCreator/products/{slug}/product.json'
    if not os.path.exists(pj_path):
        print(f'{slug}: product.json yok')
        continue
    with open(pj_path) as f:
        pj = json.load(f)
    
    target_url = canonical_map[slug]
    updated = False
    
    for field in ['vercel_url', 'url', 'deployment_url', 'live_url']:
        current = pj.get(field, '')
        if current and current != target_url:
            ideal = f'https://{slug}.vercel.app'
            if ideal in current:
                pj[field] = target_url
                updated = True
    
    if updated:
