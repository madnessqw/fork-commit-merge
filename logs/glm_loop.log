now = time.time()
research_age = now - researcher_done_ts if researcher_done_ts else 99999

trigger = False
reason = ''
if deploy_gap > 20:
    trigger = True; reason = 'deploy_gap'
elif spec_ready > 5:
    trigger = True; reason = 'spec_ready'
elif research_age > 10800:  # 3 saat
    trigger = True; reason = 'research_stale'

if trigger:
