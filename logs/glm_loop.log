        old_deploy = p.get('deployment_url','')
        old_ideal = p.get('ideal_vercel_url','')
        
        p['deployment_url'] = new_url
        p['ideal_vercel_url'] = new_url
        p['canonical_health_url'] = new_url
        p['canonical_probe_url'] = new_url
        p['health_probe_url'] = new_url
        p['effective_health_url'] = new_url
        p['canonical_health_code'] = 200
        p['canonical_health_status'] = 'healthy'
        
        fixed.append({
            'slug': slug,
            'old_deploy': old_deploy,
            'new_deploy': new_url
        })

with open('/home/gokhan/UniverseCreator/STATE.json', 'w') as f:
    json.dump(state, f, indent=2)

for item in fixed:
    print(f'Fixed: {item[\"slug\"]} → {item[\"new_deploy\"]}')
print(f'Total fixed: {len(fixed)} products')
