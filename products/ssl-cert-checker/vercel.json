{
  "version": 2,
  "functions": {
    "api/process.js": {
      "maxDuration": 30
    },
    "api/health.js": {
      "maxDuration": 10
    },
    "api/webhook.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/process", "dest": "/api/process.js" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/api/webhook", "dest": "/api/webhook.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
