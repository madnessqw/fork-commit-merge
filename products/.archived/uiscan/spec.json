{
  "name": "UI Scan",
  "tagline": "UI Component Extractor & Code Generator",
  "slug": "uiscan",
  "version": "1.0.0",
  "price": "$29 one-time",
  "mvp_complexity": "2-3 cycles",
  "target_audience": ["developer", "frontend_engineer", "ui_designer", "product_manager"],
  "problem": "Web sitesinden UI component koparmak zor. Pluck var ama AI coding tools'a özel. HTML to React/Vue dönüşümü zor. CSS extraction manuel",
  "solution": "Vercel Edge + AI ile UI extraction. Screenshot to code, CSS extraction, component generation, multi-framework export",
  "tech_stack": {
    "runtime": "Vercel Edge Functions",
    "ai": "Gemini Vision API",
    "parser": "JSDOM",
    "cache": "Vercel KV",
    "payment": "Stripe"
  },
  "api": {
    "base_url": "https://uiscan.io/",
    "endpoints": [
      {
        "path": "/api/extract",
        "method": "POST",
        "description": "Extract UI from URL or image",
        "body": {
          "url": "string (optional)",
          "image": "base64 (optional)",
          "framework": "react | vue | svelte | html"
        },
        "response": {
          "componentId": "ui_abc123",
          "html": "<div class='card'>...</div>",
          "css": ".card { padding: 16px; }",
          "react": "export default function Card() {...}",
          "vue": "<template>...</template>"
        }
      },
      {
        "path": "/api/analyze",
        "method": "POST",
        "description": "Analyze UI structure",
        "body": {"url": "string"},
        "response": {
          "components": [
            {"type": "button", "count": 5, "styles": {...}},
            {"type": "card", "count": 3, "styles": {...}}
          ],
          "colors": ["#6366f1", "#f1f163"],
          "fonts": ["Inter", "Roboto"]
        }
      },
      {
        "path": "/api/colors",
        "method": "POST",
        "description": "Extract color palette",
        "body": {"url": "string"},
        "response": {
          "palette": [
            {"color": "#6366f1", "usage": "primary"},
            {"color": "#f1f163", "usage": "accent"}
          ],
          "cssVariables": ":root { --primary: #6366f1; }"
        }
      }
    ]
  },
