  "problem": "CSV dosyalarını işlemek için PapaParse kurulumu gerekiyor. CSV↔JSON dönüşümü için online tool'lar var ama API yok. Büyük CSV dosyalarını parçalamak zor. CSV validasyonu için ayrı araçlar lazım",
  "solution": "Vercel Edge + PapaParse ile CSV manipulation API. CSV↔JSON, CSV↔Excel, CSV merge/split, validation, column mapping",
  "tech_stack": {
    "runtime": "Vercel Edge Functions",
    "csv_parser": "PapaParse (npm)",
    "excel": "xlsx (npm)",
    "cache": "Vercel KV",
    "payment": "Stripe"
  },
  "api": {
    "base_url": "https://csvforge.io/",
    "endpoints": [
      {
        "path": "/api/convert/json",
        "method": "POST",
        "description": "Convert CSV to JSON",
        "body": {
          "csv": "string (CSV content or URL)",
          "delimiter": "string (default: comma)",
          "headers": "boolean (default: true)",
          "dynamicTyping": "boolean (auto-detect types)"
        },
        "response": {
          "data": [{"name": "John", "age": 30}],
          "meta": {"fields": ["name", "age"], "rowCount": 100}
        }
      },
      {
        "path": "/api/convert/csv",
        "method": "POST",
        "description": "Convert JSON to CSV",
        "body": {
          "data": "array of objects",
          "fields": "array (optional column order)",
          "delimiter": "string (default: comma)"
        }
      },
      {
        "path": "/api/validate",
        "method": "POST",
        "description": "Validate CSV structure",
        "body": {
          "csv": "string",
          "expectedColumns": "number (optional)"
        },
        "response": {
          "valid": true,
          "errors": [],
          "rowCount": 100,
          "columnCount": 5
        }
      },
      {
        "path": "/api/split",
        "method": "POST",
        "description": "Split CSV into chunks",
        "body": {
          "csv": "string",
          "chunkSize": "number (rows per file)"
        }
      },
      {
        "path": "/api/merge",
        "method": "POST",
        "description": "Merge multiple CSVs",
        "body": {
          "files": ["csv1 content", "csv2 content"],
          "commonColumn": "string (optional merge key)"
        }
      }
    ]
  },
