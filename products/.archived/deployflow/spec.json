  "api": {
    "base_url": "https://deployflow.io/",
    "endpoints": [
      {
        "path": "/api/deploy",
        "method": "POST",
        "description": "Deploy static site",
        "body": {
          "files": [{"path": "index.html", "content": "base64"}],
          "siteName": "my-site",
          "password": "string (optional)"
        },
        "response": {
          "siteId": "site_abc123",
          "url": "https://my-site.deployflow.io",
          "customDomain": "string (optional)"
        }
      },
      {
        "path": "/api/sites/:id",
        "method": "GET",
        "description": "Get site details",
        "response": {
          "id": "site_abc123",
          "url": "https://my-site.deployflow.io",
          "deployedAt": "2026-04-05T12:00:00Z",
          "size": 245000,
          "visits": 15234
        }
      },
      {
        "path": "/api/sites/:id/preview",
        "method": "POST",
        "description": "Create preview deployment",
        "response": {
          "previewUrl": "https://preview-xyz.deployflow.io",
          "expiresIn": "7 days"
        }
      },
      {
        "path": "/api/sites/:id/analytics",
        "method": "GET",
        "description": "Get site analytics",
        "response": {
          "visits": 15234,
          "uniqueVisitors": 8902,
          "bandwidth": "2.4GB"
        }
      }
    ]
  },
