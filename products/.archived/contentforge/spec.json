  "api": {
    "base_url": "https://contentforge.io/",
    "endpoints": [
      {
        "path": "/api/generate/blog",
        "method": "POST",
        "description": "Generate blog post",
        "body": {
          "topic": "string (required)",
          "tone": "professional | casual | technical | friendly",
          "length": "short | medium | long",
          "keywords": ["array"],
          "audience": "string"
        },
        "response": {
          "title": "Generated Blog Title",
          "content": "Full blog post content...",
          "meta": {"wordCount": 500, "readingTime": "3 min"},
          "keywords": ["keyword1", "keyword2"]
        }
      },
      {
        "path": "/api/generate/social",
        "method": "POST",
        "description": "Generate social media posts",
        "body": {
          "content": "string (blog or product)",
          "platforms": ["twitter", "linkedin", "instagram"],
          "tone": "string"
        },
        "response": {
          "posts": [
            {"platform": "twitter", "text": "Post content...", "hashtags": ["#tag"]},
            {"platform": "linkedin", "text": "Longer post..."}
          ]
        }
      },
      {
        "path": "/api/generate/product",
        "method": "POST",
        "description": "Generate product descriptions",
        "body": {
          "productName": "string",
          "features": ["array"],
          "targetAudience": "string",
          "tone": "professional | playful | luxury"
        }
      },
      {
        "path": "/api/templates",
        "method": "GET",
        "description": "List available templates"
      },
      {
        "path": "/api/rewrite",
        "method": "POST",
        "description": "Rewrite existing content",
        "body": {
          "content": "string",
          "style": "simplify | expand | professional | casual"
        }
      }
    ]
  },
