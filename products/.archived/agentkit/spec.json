  },
  "api": {
    "base_url": "https://agentkit.io/",
    "endpoints": [
      {
        "path": "/api/agents",
        "method": "POST",
        "description": "Create new agent",
        "body": {
          "name": "string",
          "systemPrompt": "string (required)",
          "tools": ["web_search", "calculator", "code_execution"],
          "model": "gemini-2.0-flash | claude-3-haiku",
          "memory": true
        },
        "response": {
          "agentId": "agent_abc123",
          "endpoint": "https://agentkit.io/api/agents/agent_abc123/run"
        }
      },
      {
        "path": "/api/agents/:id/run",
        "method": "POST",
        "description": "Run agent with input",
        "body": {
          "input": "string (required)",
          "context": {},
          "maxSteps": 10
        },
        "response": {
          "output": "Agent response",
          "steps": [{"thought": "...", "action": "...", "observation": "..."}],
          "tokensUsed": 245
        }
      },
      {
        "path": "/api/workflows",
        "method": "POST",
        "description": "Create multi-agent workflow",
        "body": {
          "name": "string",
          "steps": [
            {"agent": "agent_id", "input": "{{user_input}}"},
            {"agent": "agent_id2", "input": "{{previous.output}}"}
          ]
        }
      },
      {
        "path": "/api/tools",
        "method": "GET",
        "description": "List available tools"
      }
    ]
  },
