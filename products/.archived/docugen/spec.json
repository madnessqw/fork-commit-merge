  "problem": "API dokümantasyonu için Swagger/OpenAPI yazmak zor. ReadMe pahalı ($19/ay). Postman dokümantasyonu sınırlı. Manuel dokümantasyon güncellemesi zaman alıcı",
  "solution": "Vercel Edge ile API'den otomatik doküman üretme. OpenAPI generation, markdown export, interactive playground, changelog",
  "tech_stack": {
    "runtime": "Vercel Edge Functions",
    "parser": "swagger-parser",
    "renderer": "redoc (lite)",
    "cache": "Vercel KV",
    "payment": "Stripe"
  },
  "api": {
    "base_url": "https://docugen.io/",
    "endpoints": [
      {
        "path": "/api/generate",
        "method": "POST",
        "description": "Generate docs from OpenAPI spec",
        "body": {
          "spec": "string (OpenAPI JSON/YAML or URL)",
          "theme": "default | dark | minimal",
          "logo": "string (URL)",
          "brandColor": "string (hex)"
        },
        "response": {
          "docUrl": "https://docugen.io/docs/abc123",
          "embedCode": "<iframe src='...'></iframe>",
          "markdown": "string"
        }
      },
      {
        "path": "/api/analyze",
        "method": "POST",
        "description": "Analyze API and generate OpenAPI spec",
        "body": {
          "endpoints": [
            {
              "method": "GET",
              "path": "/api/users",
              "description": "Get all users"
            }
          ]
        },
        "response": {
          "openapi": "3.0.0 spec",
          "suggestions": ["Add response examples", "Define error codes"]
        }
      },
      {
        "path": "/api/playground",
        "method": "GET",
        "description": "Get interactive API playground",
        "parameters": {
          "specId": "string"
        }
      },
      {
        "path": "/api/export",
        "method": "POST",
        "description": "Export docs to various formats",
        "body": {
          "format": "markdown | html | pdf",
          "specId": "string"
        }
      }
    ]
  },
