  "slug": "meetflow",
  "version": "1.0.0",
  "price": "$29 one-time",
  "mvp_complexity": "2 cycles",
  "target_audience": ["remote_worker", "product_manager", "developer", "team_lead"],
  "problem": "Meeting not almak zor. Otter.ai $10/ay. Zoom transcription sınırlı. Meeting summary için AI tool'ları pahalı. Action items extract etmek manual",
  "solution": "Vercel Edge + Gemini API ile meeting transcription. Audio-to-text, AI summary, action items, key decisions, searchable archive",
  "tech_stack": {
    "runtime": "Vercel Edge Functions",
    "transcription": "Gemini 2.0 Flash (audio)",
    "summarization": "Gemini API",
    "storage": "Vercel KV + Blob",
    "payment": "Stripe"
  },
  "api": {
    "base_url": "https://meetflow.io/",
    "endpoints": [
      {
        "path": "/api/transcribe",
        "method": "POST",
        "description": "Transcribe audio file",
        "body": {
          "audio": "base64 or URL",
          "language": "en | tr | de | es",
          "speakers": 2
        },
        "response": {
          "transcriptId": "tr_abc123",
          "transcript": [
            {"speaker": "Speaker 1", "text": "Hello everyone", "timestamp": "00:00:05"}
          ],
          "duration": 1800
        }
      },
      {
        "path": "/api/summarize",
        "method": "POST",
        "description": "Generate AI summary",
        "body": {
          "transcriptId": "string",
          "style": "brief | detailed | bullet-points"
        },
        "response": {
          "summary": "Meeting summary...",
          "keyPoints": ["Point 1", "Point 2"],
          "actionItems": [
            {"task": "Review PR", "assignee": "John", "due": "2026-04-10"}
          ],
          "decisions": ["Decision 1"]
        }
      },
      {
        "path": "/api/meetings",
        "method": "GET",
        "description": "List all meetings",
        "parameters": {
          "search": "string",
          "dateFrom": "date",
          "dateTo": "date"
        }
      },
      {
        "path": "/api/search",
        "method": "GET",
        "description": "Search across all transcripts",
        "parameters": {
          "q": "string (search query)"
        }
      }
    ]
  },
