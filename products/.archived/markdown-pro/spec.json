  "problem": "HTML'yi Markdown'a çevirmek için turndown kütüphanesi kurmak gerekiyor. ChatGPT'den gelen HTML response'ları Markdown'a çevirmek lazım. Web scraping sonucu HTML'i temiz Markdown'a dönüştürmek zor",
  "solution": "Vercel Edge + turndown/showdown ile HTML ↔ Markdown converter API. Table, code block, image dönüşümü. GitHub-flavored Markdown desteği",
  "tech_stack": {
    "runtime": "Vercel Edge Functions",
    "html_to_md": "turndown (npm)",
    "md_to_html": "showdown (npm)",
    "cache": "Vercel KV",
    "payment": "Stripe"
  },
  "api": {
    "base_url": "https://mdpro.io/",
    "endpoints": [
      {
        "path": "/api/html-to-markdown",
        "method": "POST",
        "description": "Convert HTML to Markdown",
        "body": {
          "html": {
            "type": "string",
            "required": true,
            "description": "HTML content"
          },
          "options": {
            "headingStyle": "setext | atx (default: atx)",
            "bulletListMarker": "* | - | + (default: *)",
            "codeBlockStyle": "fenced | indented (default: fenced)",
            "emDelimiter": "_ | * (default: _)",
            "strongDelimiter": "** | __ (default: **)"
          }
        },
        "response": {
          "markdown": "# Heading\n\nContent...",
          "stats": {
            "inputLength": 1200,
            "outputLength": 450,
            "headings": 3,
            "links": 5,
            "images": 2
          }
        }
      },
      {
        "path": "/api/markdown-to-html",
        "method": "POST",
        "description": "Convert Markdown to HTML",
        "body": {
          "markdown": "string (required)",
          "options": {
            "tables": true,
            "tasklists": true,
            "strikethrough": true
          }
        },
        "response": {
          "html": "<h1>Heading</h1><p>Content...</p>"
        }
      },
      {
        "path": "/api/url-to-markdown",
        "method": "GET",
        "description": "Fetch URL and convert to Markdown",
        "parameters": {
          "url": "string (required)"
        }
      }
    ]
  },
