  "api": {
    "base_url": "https://webhookspy.io/",
    "endpoints": [
      {
        "path": "/api/hook/:id",
        "method": "POST",
        "description": "Receive webhook and store payload",
        "response": {
          "received": true,
          "id": "req_abc123",
          "timestamp": "2026-04-05T12:00:00Z"
        }
      },
      {
        "path": "/api/requests/:id",
        "method": "GET",
        "description": "Get captured webhook requests",
        "response": {
          "webhookId": "hook_abc123",
          "requests": [
            {
              "id": "req_abc123",
              "method": "POST",
              "headers": {
                "content-type": "application/json",
                "x-signature": "sha256=..."
              },
              "body": "request payload",
              "query": {},
              "timestamp": "2026-04-05T12:00:00Z",
              "ip": "192.168.1.1"
            }
          ],
          "total": 1
        }
      },
      {
        "path": "/api/replay/:requestId",
        "method": "POST",
        "description": "Replay a captured webhook to your endpoint",
        "body": {
          "targetUrl": "string (where to replay)"
        },
        "response": {
          "replayed": true,
          "targetUrl": "https://your-api.com/webhook",
          "responseStatus": 200
        }
      },
      {
        "path": "/api/hook/:id/config",
        "method": "PUT",
        "description": "Configure webhook endpoint",
        "body": {
          "responseCode": 200,
          "responseBody": "{\"status\":\"ok\"}",
          "responseHeaders": {}
        }
      }
    ]
  },
