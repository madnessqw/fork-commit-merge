{
  "name": "WASM Forge",
  "tagline": "WebAssembly Module Builder & Runtime API",
  "slug": "wasmforge",
  "version": "1.0.0",
  "price": "$29 one-time",
  "mvp_complexity": "2-3 cycles",
  "target_audience": ["developer", "web_assembly_engineer", "performance_optimizer", "frontend_architect"],
  "problem": "WASM modülü derlemek için Emscripten kurulumu karmaşık. WASI runtime'ları çeşitli. WASM performans testi için araç yok. Browser ve server WASM farklılıkları",
  "solution": "Vercel Edge + WASM runtime ile WASM builder ve runner. Rust/C to WASM, WASI support, performance metrics, module validation",
  "tech_stack": {
    "runtime": "Vercel Edge Functions",
    "wasm_runtime": "Wasmtime (light)",
    "compiler": "Remote compilation service",
    "storage": "Vercel KV + Blob",
    "payment": "Stripe"
  },
  "api": {
    "base_url": "https://wasmforge.io/",
    "endpoints": [
      {
        "path": "/api/compile",
        "method": "POST",
        "description": "Compile source to WASM",
        "body": {
          "language": "rust | c | cpp | go",
          "source": "string or URL",
          "optimization": "0 | 1 | 2 | 3 | s | z",
          "target": "wasm32-unknown-unknown | wasm32-wasi"
        },
        "response": {
          "wasmUrl": "https://wasmforge.io/modules/abc123.wasm",
          "size": 24500,
          "functions": ["add", "subtract"],
          "imports": [],
          "exports": ["memory", "add"]
        }
      },
      {
        "path": "/api/run",
        "method": "POST",
        "description": "Execute WASM module",
        "body": {
          "wasmUrl": "string (required)",
          "function": "string (export name)",
          "args": [1, 2],
          "memoryLimit": "64MB"
        },
        "response": {
          "result": 3,
          "executionTime": 0.5,
          "memoryUsed": "1.2MB"
        }
      },
      {
        "path": "/api/analyze",
        "method": "POST",
        "description": "Analyze WASM module",
        "body": {
          "wasmUrl": "string"
        },
        "response": {
          "size": 24500,
          "functions": 12,
          "imports": 3,
          "exports": 8,
          "complexity": "low",
          "suggestions": ["Enable LTO for smaller size"]
        }
      },
      {
        "path": "/api/validate",
        "method": "POST",
        "description": "Validate WASM module",
        "body": {
          "wasmUrl": "string"
        },
        "response": {
          "valid": true,
          "version": "1.0",
          "features": ["mutable_globals", "multi_value"]
        }
      }
    ]
  },
