{
  "name": "Cronify",
  "tagline": "Cron Expression Parser & Humanizer API",
  "slug": "cronify",
  "version": "1.0.0",
  "price": "$19 one-time",
  "mvp_complexity": "1 cycle",
  "target_audience": ["developer", "devops", "saas_founder", "automation_engineer"],
  "problem": "Developer'lar cron expression'ları parse etmek ve anlamak için crontab.guru gibi manuel araçlar kullanıyor. Cron'u İngilizce'ye çeviren (human-readable) ve sonraki çalışma zamanlarını hesaplayan API yok",
  "solution": "Vercel Edge + cron-parser paketi ile cron expression parser API. Cron'u doğrulama, human-readable format, sonraki çalışma zamanları, ve schedule detayları döner",
  "tech_stack": {
    "runtime": "Vercel Edge Functions",
    "parser": "cron-parser (npm)",
    "humanizer": "cronstrue (npm)",
    "cache": "Vercel KV",
    "payment": "Stripe"
  },
  "api": {
    "base_url": "https://cronify.api/",
    "endpoints": [
      {
        "path": "/api/parse",
        "method": "POST",
        "description": "Parse cron expression",
        "body": {
          "cron": {
            "type": "string",
            "required": true,
            "description": "Cron expression (e.g., '0 9 * * MON')"
          },
          "timezone": {
            "type": "string",
            "default": "UTC",
            "description": "IANA timezone (e.g., 'Europe/Istanbul')"
          },
          "nextRuns": {
            "type": "number",
            "default": 5,
            "max": 100,
            "description": "Number of next execution times to return"
          }
        },
        "response": {
          "cron": "0 9 * * MON",
          "isValid": true,
          "description": "At 09:00 AM, only on Monday",
          "humanReadable": "Every Monday at 9:00 AM",
          "nextRuns": [
            "2026-04-06T09:00:00+03:00",
            "2026-04-13T09:00:00+03:00",
            "2026-04-20T09:00:00+03:00"
          ],
          "schedule": {
            "minute": 0,
            "hour": 9,
            "dayOfMonth": "*",
            "month": "*",
            "dayOfWeek": "MON",
            "dayOfWeekArray": [1]
          },
          "timezone": "Europe/Istanbul"
        }
      },
      {
        "path": "/api/validate",
        "method": "GET",
        "description": "Validate cron expression",
        "parameters": {
          "cron": {
            "type": "string",
            "required": true
          }
        },
        "response": {
          "valid": true,
          "message": "Valid cron expression",
          "cron": "0 9 * * *"
        }
      },
      {
        "path": "/api/humanize",
        "method": "POST",
        "description": "Convert cron to human-readable text",
        "body": {
          "cron": "0 */6 * * *",
          "locale": "en (default) | tr | de | fr | es"
        },
        "response": {
          "cron": "0 */6 * * *",
          "humanReadable": "Every 6 hours",
          "locale": "en"
        }
      },
      {
        "path": "/api/batch",
        "method": "POST",
        "description": "Parse multiple cron expressions",
        "body": {
          "expressions": [
            {"cron": "0 9 * * MON", "label": "Monday job"},
            {"cron": "0 */6 * * *", "label": "Every 6 hours"}
          ],
          "timezone": "UTC"
        },
        "response": {
          "results": [
            {
              "cron": "0 9 * * MON",
              "isValid": true,
              "description": "At 09:00 AM, only on Monday"
            }
          ]
        }
      }
    ]
  },
  "competitors": [
    {
      "name": "crontab.guru",
      "price": "Free",
      "type": "Website",
      "pros": ["Popular", "Simple UI"],
      "cons": ["No API", "Manual only", "No timezone support"]
    },
    {
      "name": "cronjob.xyz",
      "price": "Free",
      "type": "Validator",
      "pros": ["Quick check"],
      "cons": ["No parse feature", "No API", "Basic only"]
    },
    {
      "name": "Easycron",
      "price": "$12/month",
      "type": "Cron service",
      "pros": ["Cron execution"],
      "cons": ["Not a parser API", "Monthly subscription", "Different use case"]
    }
  ],
  "advantage": "One-time $19 + Full API access + Human-readable descriptions + Timezone support + Next run calculation",
  "features": [
    "Cron expression validation",
    "Human-readable descriptions (20+ locales)",
    "Next execution times (up to 100)",
    "Timezone support (IANA)",
    "Batch processing",
    "Schedule breakdown (minute, hour, etc.)",
    "JSON response",
    "No rate limits"
  ],
  "use_cases": [
    "Cron job scheduler UIs",
    "DevOps dashboards",
    "CI/CD pipeline tools",
    "Task automation platforms",
    "Monitoring tools",
    "Configuration management"
  ],
  "estimated_revenue": {
    "conservative": "40 sales/month = $760",
    "moderate": "100 sales/month = $1,900",
    "optimistic": "200 sales/month = $3,800"
  },
  "why_best_choice": [
    "Mavi Okyanus - Almost no API competitors",
    "Simple - Just npm packages (cron-parser + cronstrue)",
    "Edge compatible - Works on Vercel",
    "Universal - Every developer uses cron",
    "Low price - $19 impulse buy"
  ]
}
